{
  "name": "@illus/pipeline",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Section orchestrator: cache → context → plan → extract → validate → compile → critic → store, with queues and cancellation.",
  "exports": {
    ".": "./src/index.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "fixtures:llm": "ILLUS_WRITE_FIXTURES=1 vitest run test/synthetic.e2e.test.ts",
    "fixtures:browser": "ILLUS_WRITE_BROWSER_FIXTURES=1 vitest run test/browser-replay.test.ts"
  },
  "dependencies": {
    "@illus/concepts": "workspace:*",
    "@illus/context": "workspace:*",
    "@illus/core": "workspace:*",
    "@illus/llm": "workspace:*"
  },
  "devDependencies": {
    "@flow/epubjs": "workspace:*",
    "@illus/book-index": "workspace:*",
    "@illus/eslint-config": "workspace:*",
    "@types/node": "24.13.6",
    "eslint": "10.11.0",
    "jsdom": "30.1.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
