{
  "name": "@illus/tracer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Pyodide trace worker, tracer.py, trace compression and the trace view.",
  "exports": {
    ".": "./src/index.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "build:assets": "node scripts/copy-assets.mjs",
    "e2e": "pnpm build:assets && playwright test"
  },
  "dependencies": {
    "@illus/core": "workspace:*",
    "@illus/render": "workspace:*",
    "comlink": "4.4.2",
    "pyodide": "314.0.7",
    "shiki": "4.4.3"
  },
  "devDependencies": {
    "@illus/eslint-config": "workspace:*",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.6",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "eslint": "10.11.0",
    "react": "18.0.0",
    "react-dom": "18.0.0",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  }
}
