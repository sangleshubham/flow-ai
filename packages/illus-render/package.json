{
  "name": "@illus/render",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "React renderers (ELK graph worker, Mermaid, Vega-Lite, KaTeX, timeline, HTML sandbox), shared chrome, theme tokens, export, template library.",
  "exports": {
    ".": "./src/index.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run --passWithNoTests",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@illus/core": "workspace:*",
    "comlink": "4.4.2",
    "dompurify": "3.4.16",
    "elkjs": "0.12.0",
    "katex": "0.18.9",
    "mermaid": "11.17.2",
    "vega": "6.4.0",
    "vega-embed": "7.3.0",
    "vega-interpreter": "2.3.2",
    "vega-lite": "6.4.3"
  },
  "devDependencies": {
    "@illus/eslint-config": "workspace:*",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "eslint": "10.11.0",
    "jsdom": "30.1.1",
    "react": "18.0.0",
    "react-dom": "18.0.0",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "4.1.11"
  }
