# Copy to apps/reader/.env.local for `pnpm dev` / `next start` (docker-compose reads a root .env instead).
# Generate secrets locally; never commit the copy. Full list and meaning: docs/deploy.md, spec §9.
ILLUS_LLM_MODE=replay
ILLUS_PUBLIC_URL=http://127.0.0.1:7127
ILLUS_ALLOWED_ACCOUNT_ID=
ILLUS_TOKEN_ENC_KEY=
ILLUS_SESSION_SECRET=
ILLUS_DATA_DIR=./.illus-data
# Optional
ILLUS_LOGIN_PASSWORD=
ILLUS_CHATGPT_CLIENT_ID=
ILLUS_MAX_REQUESTS_5H=100
ILLUS_MAX_REQUESTS_DAY=300
ILLUS_MODELS_JSON=
ILLUS_OPENAI_API_KEY=
# `next dev` only: ILLUS_AUTH_GATE=off skips the login gate (ignored by production builds).
ILLUS_AUTH_GATE=
